# SDG PoC connection settings. Copy to .env and fill in. Never commit .env.
# For this machine and the demo laptop. At the customer copy
# scripts/customer/customer.env.example instead (ENVIRONMENTS.md).

# local (this machine) or laptop (the demo laptop). customer makes the demo
# scripts refuse to run.
SDG_ENV=local

SDG_MSSQL_SERVER=localhost
SDG_MSSQL_PORT=1433
SDG_MSSQL_USER=sa
SDG_MSSQL_PASSWORD=change-me
SDG_MSSQL_DRIVER=ODBC Driver 18 for SQL Server
SDG_MSSQL_TRUST_CERT=yes
# Encrypt the connection; left out, yes when TRUST_CERT is. Set yes with
# TRUST_CERT=no where the server's certificate is one this machine trusts.
# SDG_MSSQL_ENCRYPT=yes
# Windows authentication for everything. On a domain-joined machine this means
# no password is stored anywhere; leave the user and password blank.
SDG_MSSQL_TRUSTED=no

# The databases this tool works across.
#
#   source  a database to read. Scooped into the store at design time.
#   denorm  the analysis store: the extracts every source is read into, and
#           this tool's own tables beside them. Created by scripts\seed.cmd.
#   target  where generated rows are written. Defaults to the source, which is
#           the usual case; name it separately to generate into another
#           database you have onboarded.
#   ref     reference/master data.
SDG_DB_SOURCE=FACETS_QA
SDG_DB_DENORM=SDM_DENORM
SDG_DB_TARGET=FACETS_QA
SDG_DB_REF=MDM_REF

# The business this installation serves: what its records are called, which
# tables are reference data, what patterns are found on, the formats offered.
# One of the folders in sdg/packs (health when not set).
# SDG_PACK=health

# The pattern store (the denorm database: member_denorm, claims_denorm and this
# tool's own tables). Each setting falls back to the SDG_MSSQL_* one above, so
# leave them unset when the store is on the same server with the same login.
# On a customer's side, where the denorm database is their own, set them here.
#   SDG_DENORM_SCHEMA   the one schema the tool may read and write (default sdm)
# SDG_DENORM_SERVER=
# SDG_DENORM_PORT=1433
# SDG_DENORM_USER=
# SDG_DENORM_PASSWORD=
# SDG_DENORM_TRUSTED=no
# SDG_DENORM_DRIVER=ODBC Driver 18 for SQL Server
# SDG_DENORM_TRUST_CERT=yes
# SDG_DENORM_ENCRYPT=yes
# SDG_DENORM_SCHEMA=sdm

# The date ages, tenures and "recent" are measured from. Stated rather than
# taken from the clock, so a pattern found today means the same thing when it
# is replayed next year.
SDG_AS_OF=2026-01-01
SDG_ANALYZER_AS_OF=2026-01-01

# The key analysis results cached on disk are signed with, so a cache file
# copied in from elsewhere is never loaded. Unset, a random key is made once
# in sdg/analyzer/cache/cache.key. Set it to keep the key outside the install.
# SDG_CACHE_KEY=

# Working directory for CLI artifacts
SDG_WORK_DIR=work

# Whether generated rows may be written into a database. no = files only:
# reading and profiling a database, patterns and files all work as before, but
# Generation offers no database load and nothing generated is inserted anywhere.
# Left out, it is yes only on a machine with SDG_ENV=local or laptop.
SDG_DATABASE_GENERATION=yes

# Databases SDM never reads or writes from its screens or loads (production),
# separated by commas. Required on a customer machine: SDM refuses without it.
# SDM's SQL scripts name them in their guards when SDM runs them. On a customer
# machine the source (SDG_DB_SOURCE) is protected as well -- only the extract
# reads it.
# SDG_PROTECTED_DATABASES=<production database names>

# Words taken out of group names when patterns are named -- the company's own
# name, which every group name carries -- separated by commas. Optional.
# SDG_NAMING_DROP_WORDS=

# Reading a database: a table with more rows than this is not read whole. Its
# measures come from a sample, and its keys' ranges from its indexes, so a
# billion-row table reads in minutes. Counted per table. 0 reads every table
# whole, however large.
SDG_WHOLE_READ_MAX_ROWS=50000000

# Profiling a database: after this many minutes, the tables still to come get
# their column measures only, and the checks between columns and between dates
# are listed as left out. 0 sets no limit.
SDG_PROFILE_MAX_MINUTES=60

# The API answers only SDM's own screens: each call carries a token the server
# makes when it starts, and names this machine. A script calling the API sets
# the token here (and sends it as X-SDM-Token); left out, it is new each start.
# SDG_API_TOKEN=
# Other names this machine is reached by (a team demo over the network),
# comma separated. localhost and the machine's own name and addresses always work.
# SDG_ALLOWED_HOSTS=

# X12 files are marked test data (ISA15 = T). P marks them production, which a
# partner's system takes as real: only for files that are meant to be.
# SDG_X12_USAGE=T

# The secret the FACETS extract keys subscriber ID surrogates with (at least
# 16 characters). Keep it private and the same for every extract of one
# customer: changing it changes every household's ID in the store.
# SDG_EXTRACT_KEY=

# The source scripts\customer\extract.cmd reads (when not set, the pack's default: health's FACETS).
# SDG_EXTRACT_SOURCE=FACETS
