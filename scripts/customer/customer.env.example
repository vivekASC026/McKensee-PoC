# SDM at a new customer. Copy to .env in the SDM folder and fill in the <...>
# parts. Never commit .env or send it by email: it holds logins.
# The setup runbook (docs\SDM-New-Setup-Runbook.docx) says what each line means.

# Says this is the customer's machine: the demo scripts (seed, bootstrap,
# first-run, upgrade, demo) refuse to run.
SDG_ENV=customer

# Production databases SDM never writes to, separated by commas. Required: SDM
# refuses on this machine without it, and its SQL scripts name these in their
# guards when SDM runs them.
SDG_PROTECTED_DATABASES=<production database names>

# SDM store: everything SDM creates and reads, in schema sdm.
SDG_DB_DENORM=<store database>
SDG_DENORM_SCHEMA=sdm
SDG_DENORM_SERVER=<store server>
SDG_DENORM_PORT=1433
SDG_DENORM_TRUSTED=yes
SDG_DENORM_USER=
SDG_DENORM_PASSWORD=
SDG_DENORM_DRIVER=ODBC Driver 18 for SQL Server
SDG_DENORM_TRUST_CERT=yes

# A source SDM reads (read only), by a short name of your choosing: here CORE.
# Add one block per source database.
SDG_SOURCE_CORE_SERVER=<source server>
SDG_SOURCE_CORE_DATABASE=<source database>
SDG_SOURCE_CORE_TRUSTED=yes
SDG_SOURCE_CORE_USER=
SDG_SOURCE_CORE_PASSWORD=
SDG_SOURCE_CORE_TRUST_CERT=yes

# Where built packs are kept: a full path OUTSIDE the SDM folder. Required
# before Build.
SDG_PACKS_DIR=<full path, e.g. D:\SDM-packs>

# The secret surrogate IDs are made from (at least 16 characters). Keep it
# private and the same for every extract: changing it changes every surrogate.
SDG_EXTRACT_KEY=<from your secrets vault>

# Set after the first build (the Build tab shows both):
# SDG_PACK=<pack id>
# SDG_EXTRACT_SOURCE=CORE

# Words taken out of group names when patterns are named (the company's own
# name, which every group name carries), separated by commas. Optional.
# SDG_NAMING_DROP_WORDS=

# Generation writes nowhere until a test database is agreed: name one that
# does not exist. Never a production database.
SDG_DB_TARGET=SDM_NO_GENERATION
SDG_DATABASE_GENERATION=no

# Reading a database: a table with more rows than this is sampled, not read
# whole (0 reads every table whole).
SDG_WHOLE_READ_MAX_ROWS=50000000

# Profiling a source: minutes before the rest gets column measures only
# (0 sets no limit).
SDG_PROFILE_MAX_MINUTES=60

SDG_WORK_DIR=work
