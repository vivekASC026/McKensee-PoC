   "role": "primary",
   "anchor": "CUSTOMER_ID",
   "key_column": "CUSTOMER_ID"
  },
  "accounts": {
   "role": "child",
   "parent": "customers",
   "anchor": "ACCOUNT_ID",
   "line_anchor": "TXN_SEQ",
   "key_columns": [
    "ACCOUNT_ID",
    "TXN_SEQ"
   ]
  }
 },
 "tables": {
  "never_generated": [
   "dbo.GL_ENTRY"
  ],
  "modes": {
   "dbo.BRANCH": "reuse",
   "dbo.PRODUCT": "reuse",
   "dbo.MCC": "reuse",
   "dbo.GL_ENTRY": "reuse",
   "dbo.AUDIT_LOG": "exclude"
  }
 },
 "plan": {
  "root_counts": {},
  "store_elements": {},
  "always_together": {},
