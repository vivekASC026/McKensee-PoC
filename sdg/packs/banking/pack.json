{
 "id": "banking",
 "name": "Retail banking",
 "version": 1,
 "_about": "A small retail bank: customers hold accounts, accounts carry transactions. The proof that SDM is one framework: no code knows this business; this folder is all of it. Its sample bank is sample/bank_source.sql, filled by seed/bank.py.",
 "plan_name": "bank-slice",
