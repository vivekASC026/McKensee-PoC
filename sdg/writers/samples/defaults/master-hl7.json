        { "position": 6, "component": 6, "algorithm_reference": { "name": "numericId" } },
        { "position": 6, "component": 7, "algorithm_reference": { "name": "numericId" } } ] },
    { "segment_id": "NK1",
      // NK1-6 Business Phone Number [XTN] - Phone/Contact
      "maskFields": [
        { "position": 7, "component": 4, "algorithm_reference": { "name": "email" } },
        { "position": 7, "component": 6, "algorithm_reference": { "name": "numericId" } },
        { "position": 7, "component": 7, "algorithm_reference": { "name": "numericId" } } ] },
    { "segment_id": "NK1",
      // NK1-12 Next of Kin / Associated Parties Employee Number [CX] - Identifier
      "maskFields": [
        { "position": 13, "component": 1, "algorithm_reference": { "name": "alnumId" } } ] },
    { "segment_id": "NK1",
      // NK1-13 Organization Name - NK1 [XON] - Employer
      "maskFields": [
