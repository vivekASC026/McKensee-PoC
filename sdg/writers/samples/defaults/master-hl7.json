      "maskFields": [
        { "position": 24, "algorithm_reference": { "name": "city" } } ] },
    { "segment_id": "PID",
      // PID-29 Patient Death Date and Time [TS] - Date
      "maskFields": [
        { "position": 30, "algorithm_reference": { "name": "PATIENT_DATE" } } ] },

    // ------------------------------------------------------------------ PD1
    { "segment_id": "PD1",
