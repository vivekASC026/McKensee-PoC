      "maskFields": [
        { "position": 5, "component": 1, "algorithm_reference": { "name": "alnumId" } } ] },
    { "segment_id": "PID",
      // PID-5 Patient Name [XPN] - Name
      "maskFields": [
        { "position": 6, "component": 1, "algorithm_reference": { "name": "lastName" } },
        { "position": 6, "component": 2, "algorithm_reference": { "name": "firstName" } },
        { "position": 6, "component": 3, "algorithm_reference": { "name": "middleName" } } ] },
