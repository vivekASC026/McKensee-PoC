{
  // The standard master for HL7 v3 Patient Registry messages (PRPA_IN201301UV02 add,
  // PRPA_IN201302UV02 revise): the patient's places, generated by SDM's own algorithms.
  // Paths are written as the CDA config writes them, from the message's root; "@x" is an
  // attribute, "where" tests the element's other attributes (an id's root), "valuePrefix"
  // says which values of a place a rule is for (tel:). Places not named here are copied
  // from the sample: the transmission wrapper, the control act, codes SDM does not make.
  "format": "HL7 v3 XML",
  "genPaths": [
    {"path": "controlActProcess/subject/registrationEvent/subject1/patient/id/@extension", "algorithm_reference": {"name": "MEMBER_ID"}},
    {"path": "controlActProcess/subject/registrationEvent/subject1/patient/patientPerson/name/given", "algorithm_reference": {"name": "FIRST_NAME"}},
    {"path": "controlActProcess/subject/registrationEvent/subject1/patient/patientPerson/name/family", "algorithm_reference": {"name": "LAST_NAME"}},
    {"path": "controlActProcess/subject/registrationEvent/subject1/patient/patientPerson/telecom/@value", "valuePrefix": "tel:", "algorithm_reference": {"name": "PHONE"}},
    {"path": "controlActProcess/subject/registrationEvent/subject1/patient/patientPerson/telecom/@value", "valuePrefix": "fax:", "algorithm_reference": {"name": "PHONE"}},
    {"path": "controlActProcess/subject/registrationEvent/subject1/patient/patientPerson/administrativeGenderCode/@code", "algorithm_reference": {"name": "SEX"}},
    {"path": "controlActProcess/subject/registrationEvent/subject1/patient/patientPerson/birthTime/@value", "algorithm_reference": {"name": "DOB"}},
    {"path": "controlActProcess/subject/registrationEvent/subject1/patient/patientPerson/addr/streetAddressLine", "algorithm_reference": {"name": "STREET_1"}},
    {"path": "controlActProcess/subject/registrationEvent/subject1/patient/patientPerson/addr/city", "algorithm_reference": {"name": "ADDRESS_CITY"}},
    {"path": "controlActProcess/subject/registrationEvent/subject1/patient/patientPerson/addr/state", "algorithm_reference": {"name": "ADDRESS_STATE"}},
    {"path": "controlActProcess/subject/registrationEvent/subject1/patient/patientPerson/addr/postalCode", "algorithm_reference": {"name": "ADDRESS_ZIP"}},
    {"path": "controlActProcess/subject/registrationEvent/subject1/patient/patientPerson/maritalStatusCode/@code", "algorithm_reference": {"name": "MARITAL_STATUS"}},
    {"path": "controlActProcess/subject/registrationEvent/subject1/patient/patientPerson/asOtherIDs/id/@extension", "where": {"root": "2.16.840.1.113883.4.1"}, "algorithm_reference": {"name": "SSN"}}
  ]
}
