              "FT1 FT105"],
    "codes": [
      {"at": "PID PID08", "table": "0001", "in": ["A", "F", "M", "N", "O", "U"]},
      {"at": "IN1 IN117", "table": "0063",
       "in": ["ASC", "BRO", "CGV", "CHD", "DEP", "DOM", "EMC", "EME", "EMR", "EXF", "FCH", "FND",
              "FTH", "GCH", "GRD", "GRP", "LIN", "MGR", "MTH", "NCH", "NON", "OAD", "OTH", "OWN",
              "PAR", "SCH", "SEL", "SIB", "SIS", "SPO", "TRA", "UNK", "WRD"]},
      {"at": "MSH MSH11-1", "table": "0103", "in": ["D", "P", "T"]}
    ]
  },

  "codes": {
    "about": "Where HL7 codes a value the store codes otherwise (HL7 table 0001 sex, 0063 relationship): the store's value -> HL7's, else 'default'.",
    "list": [
      {"at": "PID PID08", "element": "SEX", "map": {"M": "M", "F": "F", "U": "U"}, "default": "U"},
      {"at": "IN1 IN117", "element": "RELATIONSHIP_CODE",
