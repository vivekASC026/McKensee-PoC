{
  "id": "837P",
  "transaction": "837",
  "version": "005010X222A1",
  "functional_code": "HC",
  "description": "837 Professional, 005010X222A1. The loops and elements SDM writes and the required loops a receiver expects; not the whole implementation guide.",
  "scopes": [
    {"name": "billing", "opens": "HL", "when": {"position": 3, "equals": "20"}},
    {"name": "subscriber", "opens": "HL", "when": {"position": 3, "equals": "22"}},
    {"name": "claim", "opens": "CLM"},
    {"name": "line", "opens": "LX"}
  ],
  "rules": [
    {"id": "bht-required", "level": 2, "kind": "required_segment", "segment": "BHT", "max": 1},
    {"id": "submitter-name", "level": 2, "kind": "required_segment", "segment": "NM1", "when": {"position": 1, "equals": "41"}, "label": "Submitter name (1000A NM1*41)"},
    {"id": "submitter-contact", "level": 2, "kind": "required_segment", "segment": "PER", "when": {"position": 1, "equals": "IC"}, "label": "Submitter EDI contact (1000A PER*IC)"},
    {"id": "receiver-name", "level": 2, "kind": "required_segment", "segment": "NM1", "when": {"position": 1, "equals": "40"}, "label": "Receiver name (1000B NM1*40)"},
    {"id": "billing-hl", "level": 2, "kind": "required_segment", "segment": "HL", "when": {"position": 3, "equals": "20"}, "label": "Billing provider HL (2000A)"},
    {"id": "billing-name", "level": 2, "kind": "required_segment", "scope": "billing", "segment": "NM1", "when": {"position": 1, "equals": "85"}, "label": "Billing provider name (2010AA NM1*85)"},
    {"id": "billing-address", "level": 2, "kind": "required_segment", "scope": "billing", "segment": "N3", "label": "Billing provider address (2010AA N3)"},
    {"id": "billing-city", "level": 2, "kind": "required_segment", "scope": "billing", "segment": "N4", "label": "Billing provider city, state, ZIP (2010AA N4)"},
    {"id": "billing-tax-id", "level": 2, "kind": "required_segment", "scope": "billing", "segment": "REF", "when": {"position": 1, "in": ["EI", "SY"]}, "label": "Billing provider tax ID (2010AA REF*EI)"},
    {"id": "subscriber-sbr", "level": 2, "kind": "required_segment", "scope": "subscriber", "segment": "SBR", "max": 1, "label": "Subscriber information (2000B SBR)"},
    {"id": "subscriber-name", "level": 2, "kind": "required_segment", "scope": "subscriber", "segment": "NM1", "when": {"position": 1, "equals": "IL"}, "label": "Subscriber name (2010BA NM1*IL)"},
    {"id": "payer-name", "level": 2, "kind": "required_segment", "scope": "subscriber", "segment": "NM1", "when": {"position": 1, "equals": "PR"}, "label": "Payer name (2010BB NM1*PR)"},
    {"id": "claim-diagnosis", "level": 2, "kind": "required_segment", "scope": "claim", "segment": "HI", "label": "Diagnosis (2300 HI)"},
    {"id": "line-service", "level": 2, "kind": "required_segment", "scope": "line", "segment": "SV1", "max": 1, "label": "Professional service (2400 SV1)"},
    {"id": "line-date", "level": 2, "kind": "required_segment", "scope": "line", "segment": "DTP", "when": {"position": 1, "equals": "472"}, "label": "Service date (2400 DTP*472)"},

    {"id": "bht01", "level": 2, "kind": "element", "segment": "BHT", "position": 1, "required": true, "codes": ["0019"]},
    {"id": "bht02", "level": 2, "kind": "element", "segment": "BHT", "position": 2, "required": true, "codes": ["00", "18"]},
    {"id": "bht03", "level": 2, "kind": "element", "segment": "BHT", "position": 3, "required": true, "min": 1, "max": 50},
    {"id": "bht04", "level": 2, "kind": "element", "segment": "BHT", "position": 4, "required": true, "type": "DT"},
    {"id": "bht05", "level": 2, "kind": "element", "segment": "BHT", "position": 5, "required": true, "type": "TM"},
    {"id": "bht06", "level": 2, "kind": "element", "segment": "BHT", "position": 6, "required": true, "codes": ["31", "CH", "RP"]},
    {"id": "nm102", "level": 2, "kind": "element", "segment": "NM1", "position": 2, "required": true, "codes": ["1", "2"]},
    {"id": "nm103", "level": 2, "kind": "element", "segment": "NM1", "position": 3, "min": 1, "max": 60},
    {"id": "nm104", "level": 2, "kind": "element", "segment": "NM1", "position": 4, "min": 1, "max": 35},
    {"id": "nm109", "level": 2, "kind": "element", "segment": "NM1", "position": 9, "min": 2, "max": 80},
    {"id": "subscriber-id-qualifier", "level": 2, "kind": "element", "segment": "NM1", "when": {"position": 1, "equals": "IL"}, "position": 8, "required": true, "codes": ["II", "MI"]},
    {"id": "billing-npi-qualifier", "level": 2, "kind": "element", "segment": "NM1", "when": {"position": 1, "equals": "85"}, "position": 8, "required": true, "codes": ["XX"]},
    {"id": "sbr01", "level": 2, "kind": "element", "segment": "SBR", "position": 1, "required": true, "codes": ["A", "B", "C", "D", "E", "F", "G", "H", "P", "S", "T", "U"]},
    {"id": "sbr09", "level": 2, "kind": "element", "segment": "SBR", "position": 9, "required": true, "code_set": "claim_filing"},
    {"id": "dmg01", "level": 2, "kind": "element", "segment": "DMG", "position": 1, "required": true, "codes": ["D8"]},
    {"id": "dmg02", "level": 2, "kind": "element", "segment": "DMG", "position": 2, "required": true, "type": "DT"},
    {"id": "dmg03", "level": 2, "kind": "element", "segment": "DMG", "position": 3, "required": true, "codes": ["F", "M", "U"]},
    {"id": "clm01", "level": 2, "kind": "element", "segment": "CLM", "position": 1, "required": true, "min": 1, "max": 38},
    {"id": "clm02", "level": 2, "kind": "element", "segment": "CLM", "position": 2, "required": true, "type": "R", "max": 18},
    {"id": "clm05-2", "level": 2, "kind": "element", "segment": "CLM", "position": 5, "component": 2, "required": true, "codes": ["B"]},
    {"id": "clm05-3", "level": 2, "kind": "element", "segment": "CLM", "position": 5, "component": 3, "required": true, "codes": ["1", "7", "8"]},
    {"id": "clm06", "level": 2, "kind": "element", "segment": "CLM", "position": 6, "required": true, "codes": ["Y", "N"]},
    {"id": "clm07", "level": 2, "kind": "element", "segment": "CLM", "position": 7, "required": true, "codes": ["A", "B", "C"]},
    {"id": "clm08", "level": 2, "kind": "element", "segment": "CLM", "position": 8, "required": true, "codes": ["N", "W", "Y"]},
    {"id": "clm09", "level": 2, "kind": "element", "segment": "CLM", "position": 9, "required": true, "codes": ["I", "Y"]},
    {"id": "hi01-1", "level": 2, "kind": "element", "segment": "HI", "position": 1, "component": 1, "required": true, "codes": ["ABK", "BK"]},
    {"id": "lx01", "level": 2, "kind": "element", "segment": "LX", "position": 1, "required": true, "type": "N0"},
    {"id": "sv101-1", "level": 2, "kind": "element", "segment": "SV1", "position": 1, "component": 1, "required": true, "codes": ["ER", "HC", "IV", "WK"]},
    {"id": "sv102", "level": 2, "kind": "element", "segment": "SV1", "position": 2, "required": true, "type": "R", "max": 18},
    {"id": "sv103", "level": 2, "kind": "element", "segment": "SV1", "position": 3, "required": true, "codes": ["MJ", "UN"]},
    {"id": "sv104", "level": 2, "kind": "element", "segment": "SV1", "position": 4, "required": true, "type": "R", "max": 15},
    {"id": "sv107-1", "level": 2, "kind": "element", "segment": "SV1", "position": 7, "component": 1, "required": true, "type": "N0", "max": 2},
    {"id": "dtp02", "level": 2, "kind": "element", "segment": "DTP", "position": 2, "required": true, "codes": ["D8", "RD8"]},

    {"id": "claim-balances", "level": 3, "kind": "sum", "scope": "claim", "label": "Claim charge CLM02", "parts_label": "the sum of its line charges SV102", "total": {"segment": "CLM", "position": 2}, "parts": {"segment": "SV1", "position": 2}},

    {"id": "nm1-id-pair", "level": 4, "kind": "both_or_neither", "segment": "NM1", "positions": [8, 9]},
    {"id": "address-then-city", "level": 4, "kind": "followed_by", "segment": "N3", "then": "N4"},
    {"id": "dates-match-format", "level": 4, "kind": "date_by_qualifier", "segment": "DTP", "format_position": 2, "value_position": 3},
    {"id": "patient-loop-when-not-self", "level": 4, "kind": "conditional", "scope": "subscriber", "if": {"segment": "SBR", "position": 2, "not_in": ["18"]}, "then": {"segment": "HL", "when": {"position": 3, "equals": "23"}}, "text": "SBR02 is not 18 (self), so a patient loop (HL*23) is required for this subscriber."},

    {"id": "place-of-service", "level": 5, "kind": "element", "segment": "CLM", "position": 5, "component": 1, "required": true, "code_set": "place_of_service"},
    {"id": "diagnosis-form", "level": 5, "kind": "element", "segment": "HI", "position": 1, "component": 2, "required": true, "pattern": "[A-TV-Z][0-9][0-9AB]([0-9A-TV-Z]{1,4})?", "pattern_label": "ICD-10-CM without the dot"},
    {"id": "diagnosis-code-set", "level": 5, "kind": "element", "segment": "HI", "position": 1, "component": 2, "code_set": "icd10cm"},
    {"id": "procedure-form", "level": 5, "kind": "element", "segment": "SV1", "position": 1, "component": 2, "required": true, "pattern": "[0-9]{4}[0-9FTU]|[A-V][0-9]{4}", "pattern_label": "CPT (5 characters) or HCPCS Level II (a letter and 4 digits)"},
    {"id": "procedure-code-set", "level": 5, "kind": "element", "segment": "SV1", "position": 1, "component": 2, "code_set": "hcpcs"},
    {"id": "billing-npi", "level": 5, "kind": "element", "segment": "NM1", "when": {"position": 1, "equals": "85"}, "position": 9, "check": "npi"},
    {"id": "state-codes", "level": 5, "kind": "element", "segment": "N4", "position": 2, "code_set": "states"}
  ]
}
